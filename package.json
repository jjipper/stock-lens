{
	"name": "stock-timeline",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint:eslint": "eslint .",
		"lint:prettier": "prettier --list-different src",
		"lint": "pnpm run '/^lint:.*/'",
		"format": "prettier --write .",
		"preview": "vite preview",
		"prepare": "husky"
	},
	"dependencies": {
		"@mui/icons-material": "^7.3.7",
		"axios": "^1.13.6",
		"knip": "^5.85.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-router-dom": "^7.13.0",
		"react-spinners": "^0.17.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@tailwindcss/vite": "^4.1.12",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.24",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.3.1",
		"msw": "^2.12.10",
		"prettier": "^3.6.2",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"tailwindcss": "^4.1.12",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.46.4",
		"vite": "^7.2.4"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,css}": [
			"prettier --write"
		]
	}
}
